# syntax=docker/dockerfile:1
# Build with --platform linux/arm64. Hardware validation must run on the board.
ARG BASE_IMAGE=ubuntu:22.04@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11
FROM ${BASE_IMAGE}
ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/shunwendongan/kernel_bench_opt" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.description="RK3588 experiment build and benchmark environment; external assets and board drivers required"
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates git build-essential cmake pkg-config python3 python3-numpy \
      ocl-icd-opencl-dev libgomp1 libdrm2 libgbm1 libegl1 libgles2 \
      libx11-6 libx11-xcb1 libxext6 libxfixes3 libxcb1 \
      libwayland-client0 libwayland-server0 libwayland-egl1 \
    && mkdir -p /opt/image-metadata /opt/board-gpu /opt/board-rknn /work \
    && dpkg-query -W > /opt/image-metadata/packages.tsv \
    && ln -s libmali.so.1 /opt/board-gpu/libOpenCL.so \
    && rm -rf /var/lib/apt/lists/*
COPY kernels /opt/kernel-bench/kernels
COPY src /opt/kernel-bench/src
COPY scripts /opt/kernel-bench/scripts
COPY configs /opt/kernel-bench/configs
COPY tools /opt/kernel-bench/tools
COPY experiments/predit-sync/predit-sync.patch /opt/kernel-bench/experiments/predit-sync/predit-sync.patch
COPY dependencies /opt/kernel-bench/dependencies
COPY LICENSE /opt/kernel-bench/LICENSE
COPY docker/build_inside.sh /opt/kernel-bench/docker/build_inside.sh
ENV LD_LIBRARY_PATH=/work/build/runtime-lib:/opt/board-gpu:/opt/board-rknn/lib
WORKDIR /work
CMD ["/bin/bash"]
