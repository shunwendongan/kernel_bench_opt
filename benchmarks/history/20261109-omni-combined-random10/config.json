  "sampler_type": "greedy",
  "mixed_samplers": [
    "greedy"
  ],
  "temperature": 1.0,
  "topK": 1,
  "topP": 1.0,
  "penalty": 1.0,
  "prompt_cache": false,
  "is_visual": false,
  "base_dir": "${BOARD_PROJECT}/models/Qwen2.5-Omni-3B-MNN/",
  "tmp_path": "${BOARD_RUN}/cache"
