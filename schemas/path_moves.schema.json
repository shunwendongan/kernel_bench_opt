{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "experiments/path_moves.json",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "moves"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "path_moves"
      ]
    },
    "moves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    }
  }
}
