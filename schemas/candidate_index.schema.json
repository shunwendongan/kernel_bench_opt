{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "experiments/index.json",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "branch",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "record_type": {
      "type": "string",
      "enum": [
        "candidate_index"
      ]
    },
    "branch": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "candidate_kind",
          "parent_candidate_id",
          "status",
          "candidate_json",
          "design",
          "principle",
          "sources",
          "overlay_sets",
          "runs"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "candidate_kind": {
            "type": "string",
            "enum": [
              "kernel",
              "subgraph",
              "adapter",
              "route",
              "system"
            ]
          },
          "parent_candidate_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "source_delivered",
              "L1_passed",
              "L2_passed",
              "L3_passed",
              "L3_passed_single_sample",
              "rejected_numeric",
              "rejected_perf",
              "superseded",
              "abandoned"
            ]
          },
          "candidate_json": {
            "type": "string"
          },
          "design": {
            "type": "string"
          },
          "principle": {
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "overlay_sets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "runs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
